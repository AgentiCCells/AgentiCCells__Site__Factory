{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgentiCCells/AgentiCCells__Site__Factory/schema/site.schema.json",
  "title": "Site request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "domain",
    "repo",
    "requested_by"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "apply": {
      "enum": [
        "dry-run",
        "real"
      ],
      "default": "dry-run"
    },
    "domain": {
      "type": "string",
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$",
      "description": "A subdomain in a zone the factory may manage (build/validate.mjs ZONES: agenticcells.site for AgentiCCells repositories, promptugal.news for PrompTugal repositories)"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "name"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "name"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]{1,100}$",
          "default": "dev"
        }
      }
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ],
      "default": "public"
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "first_pass": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "collaborators": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "description": "GitHub logins invited with write (push) access after the site is live; each must accept the invitation",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
      }
    }
  }
}
